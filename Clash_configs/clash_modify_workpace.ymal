port: 7890
socks-port: 7891
allow-lan: false
mode: Rule
log-level: debug
external-controller: 127.0.0.1:9090
experimental:
  ignore-resolve-fail: true
hosts:
  mtalk.google.com: 108.177.125.188
# dns:
#   enable: true
#   nameserver:
#     - 223.5.5.5
#     - 119.29.29.29
#   fallback:
#     - tls://1.1.1.1:853
#  enhanced-mode: redir-host
proxies:
  - name: Workspace-net-Founder
    type: http
    server: fd.chinaware.sale
    port: 32332
    udp: true
  - name: Workspace-IP-Founder
    type: http
    server: 1.192.16.49
    port: 32332
    udp: true
  - name: Workspace-IP-DVLP
    type: http
    server: 47.104.203.218
    port: 20014
    udp: true
proxy-groups:
  - name: 自动选择快速节点
    type: url-test
    proxies:
      - Workspace-net-Founder
      - Workspace-IP-Founder
      - Workspace-IP-DVLP
    url: http://zx4a.cmos.cmcc/user/login
    interval: 300
  - name: PROXY
    type: select
    proxies:
      - Workspace-net-Founder
      - Workspace-IP-Founder
      - Workspace-IP-DVLP
      - DIRECT
rules:
  - PROCESS-NAME,vmware,PROXY
  - PROCESS-NAME,vmware-view.exe,PROXY
  - PROCESS-NAME,horizon-client.exe,PROXY
  - PROCESS-NAME,HDPClient.exe,PROXY
  # - IP-CIDR,172.22.207.244/32,PROXY
  # - IP-CIDR,172.18.181.139/32,PROXY
  # - IP-CIDR,172.22.176.179/32,PROXY
  # - IP-CIDR,172.20.126.247/32,PROXY
  # - IP-CIDR,172.22.128.242/32,PROXY
  # - IP-CIDR,172.22.165.92/32,PROXY
  - DOMAIN-KEYWORD,online-cmcc,PROXY
  - DOMAIN-KEYWORD,cmos.cmcc,PROXY
  - DOMAIN-KEYWORD,vmware.com,PROXY
  - MATCH,DIRECT
cfw-bypass: null
cfw-latency-timeout: 5000
